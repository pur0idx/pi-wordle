# Inventory for scripts/cluster-up.sh. Copy to cluster/hosts.env (git-ignored)
# and fill in your addresses:
#
#   cp cluster/hosts.example.env cluster/hosts.env

# Master: the Ubuntu VM on the notebook (bridged network, fixed DHCP reservation).
MASTER_IP=192.168.0.100
MASTER_USER=kube

# Workers: one entry per Pi, "hostname" or "hostname=address".
# A bare hostname is reached as <hostname>.local (mDNS, works out of the box
# on Raspberry Pi OS and macOS).
PIS="pi-1 pi-2 pi-3 pi-4 pi-5"
PI_USER=pi
