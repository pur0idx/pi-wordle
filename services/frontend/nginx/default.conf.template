# Rendered by the nginx image's entrypoint (envsubst) at container start.
# Only variables set in the environment are substituted, so nginx's own
# $hostname etc. are left alone.
# The same Service listed twice is deliberate. nginx can only retry on "the
# next server"; with two entries, a connection that lands on a gateway pod on
# a dead node is retried on a fresh connection, which kube-proxy routes to a
# (probably live) replica. max_fails=0 stops nginx from marking it down.
upstream gateway_upstream {
    server ${GATEWAY_HOST}:${GATEWAY_PORT} max_fails=0;
    server ${GATEWAY_HOST}:${GATEWAY_PORT} max_fails=0;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Lets the UI show which frontend pod/node served the request.
    add_header X-Served-By-Pod $hostname always;
    add_header X-Served-By-Node "${NODE_NAME}" always;

    location /api/ {
        proxy_pass http://gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # A connect that has not finished in 1s is a dead pod, not a slow one.
        # Connect failures happen before the request is sent, so even POSTs
        # are safe to retry.
        proxy_connect_timeout 1s;
        proxy_read_timeout 15s;
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Served-By-Pod $hostname always;
        add_header X-Served-By-Node "${NODE_NAME}" always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Served-By-Pod $hostname always;
        add_header X-Served-By-Node "${NODE_NAME}" always;
    }
}
